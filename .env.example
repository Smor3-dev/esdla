# =====================================================================
# Variables de entorno · El Secreto de la Abuela
# Copiar a .env SOLO para desarrollo local (nunca subir .env al repo).
# En producción se cargan en Netlify → Project configuration → Environment
# variables. Las marcadas [SECRETO] van con "Contains secret values".
# Las demás NO se marcan (si un valor marcado aparece en el sitio publicado,
# el escaneo de secretos de Netlify frena el deploy).
# Después de cambiar cualquier variable hay que hacer un deploy nuevo.
# =====================================================================

# --- Sitio y base de datos ---------------------------------------------
# URL pública con https y sin barra final (en la rama de pruebas: https://pruebas--TU-SITIO.netlify.app)
SITE_URL=https://elsecretodelaabuela.com.uy
# [SECRETO] Cadena "pooled" de Neon (la que tiene -pooler en el host)
DATABASE_URL=postgres://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# verify-full = TLS verificando certificado y nombre del servidor (no cambiar en producción)
DATABASE_SSL=verify-full

# --- Secretos propios (npm run gen:secrets / npm run hash-password) -----
# [SECRETO] Guardar copia en un gestor de contraseñas: sin estas claves no se descifran los datos guardados
ENCRYPTION_KEYS=k1:REEMPLAZAR_BASE64_32_BYTES
ENCRYPTION_ACTIVE_KEY=k1
# [SECRETO]
SESSION_SECRET=REEMPLAZAR
# [SECRETO]
CSRF_SECRET=REEMPLAZAR
# [SECRETO] Hash scrypt de la contraseña del panel /admin (nunca la contraseña en sí)
ADMIN_PASSWORD_HASH=scrypt$32768$8$1$REEMPLAZAR$REEMPLAZAR

# --- Mercado Pago (Tus integraciones → tu aplicación → Credenciales) ----
# [SECRETO] Access Token de la aplicación "Checkout Pro" (Orders API).
# De PRUEBA en la rama de pruebas; de PRODUCCIÓN en el sitio publicado.
MP_ACCESS_TOKEN=APP_USR-REEMPLAZAR
# [SECRETO] Access Token de la aplicación "Código QR" (la caja). Si no existe, dejar sin cargar.
# MP_POS_ACCESS_TOKEN=APP_USR-REEMPLAZAR
# [SECRETO] Clave secreta de los webhooks de cada aplicación (web y caja), separadas por coma.
# Para rotar una sin cortes: agregar la nueva, hacer deploy y al día siguiente sacar la vieja.
MP_WEBHOOK_SECRETS=REEMPLAZAR
MP_REQUIRE_SIGNATURE=true
MP_STORE_EXTERNAL_ID=ESDLA001
MP_POS_EXTERNAL_ID=ESDLAPOS001
# Solo si tienen una Point integrada en modo PDV (ver guía):
# MP_POINT_TERMINAL_ID=
ONLINE_CHECKOUT_ENABLED=true

# --- Mercado Libre (DevCenter → tu aplicación) ---------------------------
# App ID (no es secreto, pero tampoco hace falta publicarlo)
ML_CLIENT_ID=REEMPLAZAR_APP_ID
# [SECRETO] Client Secret
ML_CLIENT_SECRET=REEMPLAZAR
# Idéntica a la "URI de redirect" cargada en el DevCenter
ML_REDIRECT_URI=https://elsecretodelaabuela.com.uy/api/admin/ml/callback
ML_AUTH_BASE=https://auth.mercadolibre.com.uy
# Id de usuario de la cuenta vendedora (aparece en /admin → Integraciones al conectar).
# Con esto cargado, el sistema rechaza conectar cualquier otra cuenta.
# ML_SELLER_USER_ID=
# IPs de origen de notificaciones de ML ("off" para desactivar el filtro):
# ML_WEBHOOK_ALLOWED_IPS=54.88.218.97,18.215.140.160,18.213.114.129,18.206.34.84,35.236.253.169,35.245.91.34,35.245.20.104,35.186.182.146
